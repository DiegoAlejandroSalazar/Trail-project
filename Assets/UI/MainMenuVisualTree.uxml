        <ui:Label text="TRAIL" name="GameName" class="header" style="align-self: center; background-image: none; -unity-background-image-tint-color: rgb(255, 119, 0); -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Elons.ttf?fileID=12800000&amp;guid=5e941245b78ee2668bb34c351171f663&amp;type=3#Elons&quot;); -unity-font-style: normal; -unity-text-align: upper-left; -unity-text-outline-width: 4px; letter-spacing: 1px; -unity-text-generator: standard; -unity-text-auto-size: none; font-size: 180px; top: 8%;"/>
        <ui:GroupBox style="align-self: center;">
